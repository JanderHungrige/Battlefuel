# BattleFuel backend configuration (copy to .env; never commit .env).
# All variables are prefixed with BATTLEFUEL_.

# Which unit data provider the factory builds. Wave 1 ships only "seed".
BATTLEFUEL_UNIT_PROVIDER=seed

# Combat-event feed (v2 Wave 4). "scripted" = the 6 demo events (default);
# "catalog" = the full data/combat_zone_events.csv catalog, arrival-scheduled;
# "none" = off. Set to "catalog" to demo the Wave-4 chatter overhaul live.
BATTLEFUEL_COMBAT_EVENT_FEED_PROVIDER=catalog
# Mean game-seconds between catalog events (900 game-s ≈ 15 real-s at sim_time_scale=60).
BATTLEFUEL_COMBAT_EVENT_MEAN_INTERVAL_GAME_S=900
# Deterministic seed for catalog event locations/scheduling.
BATTLEFUEL_COMBAT_EVENT_SEED=42

# --- Report a bug / suggestion → GitHub issue (doc 129) -----------------------------------
# Server-side ONLY. A fine-grained PAT scoped to just this repo with Issues: Read and write.
# Leave EMPTY in dev (the endpoint returns 503 when unset). NEVER commit a real token.
BATTLEFUEL_GITHUB_ISSUE_TOKEN=
# owner/name of the repo issues are opened on.
BATTLEFUEL_GITHUB_ISSUE_REPO=JanderHungrige/Battlefuel
# Max reports accepted per client IP per hour (spam guard).
BATTLEFUEL_REPORT_ISSUE_RATE_LIMIT_PER_HOUR=20
